# ID de dispositivo del probador: se genera una vez y no se versiona
herramientas/probador/.instalacion-id
__pycache__/

# Salida del probador para publicar (se genera en cada despliegue)
publico/

# El proyecto Android nativo lo genera `expo prebuild` y no se versiona: en un
# proyecto Expo administrado, tenerlo en el repo hace que EAS deje de aplicar
# `app.config.ts` y compile con lo que quedó congelado en la carpeta.
apps/movil/android/
apps/movil/ios/

# `eas-cli` corrido desde la raíz por error escribe un `app.json` vacío acá y se
# cuela en el commit siguiente. La configuración de Expo de este proyecto es
# `apps/movil/app.config.ts`; este archivo no significa nada y confunde a las
# herramientas que lo encuentran primero. Ya lo borró 7537d83 una vez.
/app.json

# El informe que deja herramientas/depurar-padron.mjs: son datos de clientes
