{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "20.18.0",
      "env": {
        "APP_VARIANTE": "interno",
        "ELECTRON_SKIP_BINARY_DOWNLOAD": "1"
      }
    },

    "desarrollo": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANTE": "interno",
        "ELECTRON_SKIP_BINARY_DOWNLOAD": "1"
      },
      "android": { "buildType": "apk", "gradleCommand": ":app:assembleDebug" }
    },

    "interno": {
      "extends": "base",
      "distribution": "internal",
      "channel": "interno",
      "env": {
        "APP_VARIANTE": "interno",
        "ELECTRON_SKIP_BINARY_DOWNLOAD": "1"
      },
      "android": {
        "buildType": "apk"
      }
    },

    "beta": {
      "extends": "base",
      "distribution": "internal",
      "channel": "beta",
      "env": {
        "APP_VARIANTE": "beta",
        "ELECTRON_SKIP_BINARY_DOWNLOAD": "1"
      },
      "android": {
        "buildType": "apk"
      }
    },

    "produccion": {
      "extends": "base",
      "distribution": "internal",
      "channel": "produccion",
      "env": {
        "APP_VARIANTE": "produccion",
        "ELECTRON_SKIP_BINARY_DOWNLOAD": "1"
      },
      "android": {
        "buildType": "apk"
      }
    }
  },

  "submit": {}
}
