{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // Metro empaqueta con módulos ES y resuelve `import()` en diferido. Sin
    // esto TypeScript rechaza el import diferido de la biométrica, que es lo
    // que evita que un teléfono sin el APK nuevo reviente al cargar el bundle.
    "module": "esnext",
    "noUncheckedIndexedAccess": false,
    "baseUrl": ".",
    "paths": {
      "@woodtools/compartido": ["../../packages/compartido/src/index.ts"],
      "@woodtools/compartido/*": ["../../packages/compartido/src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["node_modules"]
}
