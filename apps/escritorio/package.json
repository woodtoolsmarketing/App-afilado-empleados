{
  "name": "@woodtools/escritorio",
  "version": "0.3.0",
  "private": true,
  "description": "Panel de administración de escritorio de WoodTools",
  "author": "WoodTools S.R.L.",
  "main": "dist-electron/principal.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && electron-builder",
    "empaquetar": "vite build && electron-builder --win --publish never",
    "vista-previa": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.47.10",
    "@tanstack/react-query": "^5.62.7",
    "@woodtools/compartido": "*",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.15",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "com.woodtools.panel",
    "productName": "WoodTools Panel",
    "electronVersion": "33.4.11",
    "npmRebuild": false,
    "directories": { "output": "release" },
    "files": ["dist/**/*", "dist-electron/**/*", "recursos/**/*"],
    "win": {
      "target": ["nsis"],
      "icon": "recursos/icono.ico"
    },
    "artifactName": "WoodTools-Panel-${version}-instalador.${ext}",
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "WoodTools Panel"
    },
    "publish": null
  }
}
