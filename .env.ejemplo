# =============================================================================
# WoodTools · Rol de Visita — plantilla de variables de entorno
#
# Copiá este archivo como `.env` (está en .gitignore) y completá los valores.
# NINGUNA de estas claves se commitea.
# =============================================================================

# ── Supabase ─────────────────────────────────────────────────────────────────
# Dashboard → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=

# Sólo para scripts locales (migraciones, seeds). NUNCA en la app ni en el panel.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=

# ── Panel de escritorio (Vite necesita el prefijo VITE_) ─────────────────────
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# ── Google Maps ──────────────────────────────────────────────────────────────
# Clave 1 — va dentro del APK. Restringida por nombre de paquete + huella SHA-1.
# APIs habilitadas: Maps SDK for Android.
GOOGLE_MAPS_ANDROID_KEY=

# Clave 2 — vive SOLO en las Edge Functions. Restringida por dirección IP o sin
# restricción de aplicación, pero con las APIs acotadas a:
#   · Routes API
#   · Places API (New)
# Cargala con: supabase secrets set GOOGLE_MAPS_SERVER_KEY=...
GOOGLE_MAPS_SERVER_KEY=

# ── Gemini (transcripción de las observaciones dictadas) ─────────────────────
# https://aistudio.google.com/apikey
# Cargala con: supabase secrets set GEMINI_API_KEY=...
GEMINI_API_KEY=
GEMINI_MODELO=gemini-3.5-flash-lite

# ── EAS (compilación y distribución de la app) ───────────────────────────────
# EAS_PROJECT_ID lo devuelve `npx eas-cli init`; hay que pegarlo a mano porque
# esta app usa app.config.ts y no app.json.
EAS_PROJECT_ID=

# Si el proyecto en expo.dev se creó con otro nombre, su slug va acá: EAS
# verifica que coincida con el de app.config.ts y corta el build si no.
EAS_SLUG=

# Opcional: sin esto no hay actualizaciones por aire, sólo reinstalar el APK.
EAS_UPDATE_URL=https://u.expo.dev/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
APP_VARIANTE=interno
DOMINIO_USUARIO=woodtools.com.ar
